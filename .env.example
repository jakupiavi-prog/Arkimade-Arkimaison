# Add real values in Vercel -> Project -> Settings -> Environment Variables.
# Never commit a completed .env file or share these values in chat.
CMS_PASSWORD=
CMS_SESSION_SECRET=
# Production uses the Blob store connected in Vercel. Keep this token private.
CMS_STORAGE=blob
BLOB_READ_WRITE_TOKEN=
# Optional legacy GitHub-backed publishing:
CMS_GITHUB_TOKEN=
CMS_GITHUB_REPOSITORY=jakupiavi-prog/Arkimade-Arkimaison
CMS_GITHUB_BRANCH=main
